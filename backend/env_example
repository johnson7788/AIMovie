# ============================================================
# ViMax / AIMovie 环境配置文件模板
# ============================================================
# 使用说明：
#   1. 复制此文件为 .env: cp env_example .env
#   2. 根据实际情况填写 API Key 等配置
#   3. 只需要填写你打算使用的 AI 服务商的 Key，其他可以留空
# ============================================================

# ============================================================
# AI 服务商 API Key（至少配置一个）
# ============================================================
# 豆包/火山引擎 ARK（推荐国内用户）
# 获取地址: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
ARK_API_KEY=
# 可选：视频模型名称（部分 generator 会读取）
ARK_MODEL=doubao-seedance-1-0-pro-fast-251015

# 腾讯混元 — chat 与 image 使用不同 Key
# 获取地址: https://console.cloud.tencent.com/hunyuan
HUNYUAN_API_KEY=
HUNYUAN_VISION_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini（图片 Nanobanana / 视频 Veo）
GOOGLE_API_KEY=

# 第三方代理 GPUGeek — https://gpugeek.com
GPUGEEK=

# Agnes AI — https://www.agnes-ai.com
# 支持文本/图片/视频全链路模型
AGNES_API_KEY=

# ============================================================
# 后端服务配置
# ============================================================
SERVER_PORT=8666

# ============================================================
# 前端开发代理目标（Vite / start.sh / start.ps1）
# ============================================================
VITE_REQUEST_BASE_URL=http://127.0.0.1:8666
